<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="veluna.db" />
        <exclude domain="database" path="veluna.db-wal" />
        <exclude domain="database" path="veluna.db-shm" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="secrets.bin" />
        <exclude domain="file" path="secrets.bin.tmp" />
        <exclude domain="file" path="local_covers" />
        <exclude domain="file" path="playlist_covers" />
        <exclude domain="file" path="downloads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="veluna.db" />
        <exclude domain="database" path="veluna.db-wal" />
        <exclude domain="database" path="veluna.db-shm" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="secrets.bin" />
        <exclude domain="file" path="secrets.bin.tmp" />
        <exclude domain="file" path="local_covers" />
        <exclude domain="file" path="playlist_covers" />
        <exclude domain="file" path="downloads" />
    </device-transfer>
</data-extraction-rules>
